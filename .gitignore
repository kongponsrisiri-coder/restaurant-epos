node_modules
restaurant.db
restaurant-local.db
restaurant-local.db-journal
restaurant-local.db-wal
restaurant-local.db-shm
.env

# Client provisioning secrets — never commit
scripts/.secrets-*

# Apple Developer ID signing cert + private key — never commit (used for
# notarization via GitHub Actions secrets, not from the working tree).
# Files exported from Keychain end up as .p12 with cert + key bundled
# inside; leaking one means anyone can sign installers AS SiamEPOS.
*.p12
*.cer
*.mobileprovision
SiamEPOS-DevID/

# Built frontend — Netlify builds from source, no need to track in git
client/dist/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Embedded-Node host build (lives on the android-host branch; its working-tree
# files/binaries get left here after a branch switch — never track on main).
client/android/node-host/
# Local Netlify folder
.netlify

# Claude Code local permission grants — machine-personal, never commit
.claude/settings.local.json

# Never commit local Claude chat exports (SEC-2026-07)
Claude Chat history/
*.chat-export.json
scripts/menu-snapshot-*.json
