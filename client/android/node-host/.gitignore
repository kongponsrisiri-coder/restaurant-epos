# Native build outputs — regenerated by gradle/CMake.
/build/
/.cxx/

# On-device node project deps — reinstall with `npm install --omit=dev` inside
# nodejs-assets/nodejs-project, then drop the prebuilt arm64 better_sqlite3.node
# from /prebuilt back into node_modules/better-sqlite3/build/Release/ (see BUILD.md).
/nodejs-assets/nodejs-project/node_modules/

# Prebuilt Node runtime libs (~116 MB) — re-fetch from nodejs-mobile-react-native@18.20.4 (see BUILD.md).
/libnode/

# Runtime data — NEVER commit (may contain real restaurant data).
*.db
*.db-shm
*.db-wal
node-host-log.txt
license-state.json
preflight-probe.db
